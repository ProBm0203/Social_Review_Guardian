# .gitignore

# 1. Virtual Environments (NEVER commit these, they are huge and system-specific)
venv/
env/
.env

# 2. Python Cache (Autogenerated files that clutter your repo)
__pycache__/
*.pyc
*.pyo
*.pyd

# 3. VSCode Settings (Optional: keeps your personal editor settings private)
.vscode/

# 4. Data & Parquet Files 
# We want to keep the 'data/' folder structure, but ignore the large files inside it
data/*.parquet
*.parquet

# 5. OS Generated Files
.DS_Store
Thumbs.db